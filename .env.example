# ===================== 基础 =====================
APP_ENV=dev
DEBUG=true
# 必须 >=32 字符，生产环境务必替换（openssl rand -hex 32）
SECRET_KEY=dev-only-secret-key-please-change-0123456789
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost
# 首次启动自动建表（生产建议 false，改用 alembic upgrade head）
AUTO_CREATE_TABLES=true

# ===================== 数据库 =====================
# 本地零依赖（默认）：SQLite
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DATABASE_URL_SYNC=sqlite:///./data/app.db
# Docker / 生产：PostgreSQL 16
# DATABASE_URL=postgresql+asyncpg://app:app@postgres:5432/course_agent
# DATABASE_URL_SYNC=postgresql+psycopg://app:app@postgres:5432/course_agent
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# ===================== Redis / 队列 =====================
REDIS_URL=redis://localhost:6379/0
# false → 进程内线程池执行异步任务（无需 Redis，克隆即跑）
# true  → Celery + Redis（io / llm 双队列，可独立扩容）
USE_CELERY=false
JOB_WORKERS=4
CACHE_TTL_SEARCH=3600
JOB_POLL_INTERVAL_MS=1500

# ===================== 向量库 =====================
# local（默认，零依赖）| chroma | qdrant
VECTOR_BACKEND=local
VECTOR_DIR=./data/vectors
CHROMA_DIR=./data/chroma
QDRANT_URL=http://localhost:6333
VECTOR_COLLECTION=course_chunks

# ===================== Embedding =====================
# hash（默认，离线确定性）| api（OpenAI 兼容）| local（sentence-transformers）
# 想要真实语义检索：改 local + 重建镜像（EXTRAS 含 embedding）后**必须 reindex**。
# 演示语料（8 块）上 Hit@1 53.8%→69.2%、Hit@3 76.9%→100%；
# 真实课件（4 份 PPT / 88 块 / 60 条标注）上 Hit@1 0.475→0.625、Hit@3 0.775→0.850。
# 两套口径不可比较，详见 docs/experiments/README.md 索引。
EMBEDDING_PROVIDER=hash
# local 模式使用的模型；权重缓存到 HF_HOME（容器内 /models/hf，挂载 ./data/models）
EMBEDDING_MODEL=BAAI/bge-m3
# 必须与模型实际输出维度一致（bge-m3=1024）；换模型后必须重建索引
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=64
# api 模式：OpenAI 兼容的 /embeddings 端点（注意 DeepSeek 没有该接口）
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=

# ===================== LLM =====================
# mock（默认，离线全链路可跑）| deepseek | qwen | glm
LLM_PROVIDER=mock
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3
LLM_CONCURRENCY=4
LLM_TEMPERATURE_GEN=0.7
LLM_TEMPERATURE_GRADE=0.2
LLM_TEMPERATURE_TUTOR=0.6
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=60

# ===================== RAG 参数 =====================
# 分块边界：size（仅按字数，默认）/ heading（标题变更断开）/ slide（换页断开）
# 实测（4 份 PPT、60 条标注）：按页/按标题断开反而更差——PPT 单页仅约 138 字，
# 切细后短块语义信号变弱，门禁失效。放大块长收益更明显。详见 docs/experiments/chunking.md
CHUNK_BOUNDARY=size
# 默认 600/900 适配 PDF/Word 这类正文密度高的文档；
# PPT 课件建议 900/1200（单页信息量少、标题碎，块太小会切断知识点，实测 Hit@1 +15 点）
CHUNK_TARGET_CHARS=600
CHUNK_MAX_CHARS=900
CHUNK_MIN_CHARS=120
CHUNK_OVERLAP_CHARS=100
RETRIEVE_TOP_K=6
RETRIEVE_CANDIDATES=20
RRF_K=60
# ⚠️ 该阈值与向量模型强相关，换 embedding 后必须重扫（scripts/threshold_sweep.py）：
#    hash 向量时代 0.35 合适；切到 BGE-M3 后无关片段相似度整体抬到 0.47~0.71，
#    0.35 会让越界提问大量放行（实测误纳 50%），应调到 0.55（误纳 15%、误拒 5%）。
#    注意这是"悬崖"不是"缓坡"：0.56 起误拒从 5% 跳到 15%，0.60 时 30% 正常提问被拒。
MIN_RETRIEVE_SCORE=0.35
# 考纲外提问门禁：未登录词率 ≥0.5 且 相关度 <0.5 时拒答（见 docs/experiments/retrieval-upgrade.md）
MAX_UNKNOWN_TERM_RATIO=0.5
OFF_SYLLABUS_RELEVANCE_FLOOR=0.5
CITATION_FUZZY_THRESHOLD=0.85

# ===================== 查询改写（把口语提问改写成课件术语） =====================
# 这里是"能力总开关"：打开后仍由各检索点自行声明是否使用，当前只有导学追问启用。
# 代价约 +1.1s/次首字延迟，且会抬高跑题问题的相关度（误纳 ↑），不要开在有门禁的出题链路上。
# 取舍依据与实测数据：docs/experiments/metrics-current.md 第六节
QUERY_REWRITE_ENABLED=false

# ===================== 重排（两阶段检索第二阶段） =====================
# off（默认，只用 RRF 排序）| cross（本地交叉编码器）| llm（用现有大模型 listwise 打分）
# ⚠️ 实测结论与直觉相反：cross 在本语料**零增益**（无关片段 sigmoid 压在 0.5 附近，
#    它判的是"这段文字有没有回答该问题"，对无术语重合的口语提问给不出高分）；
#    llm 后端才把 Hit@1 由 0.625 提到 0.750，代价约 1.2s / 2.2k tokens per 次。
#    开启 cross 前需先下载权重（2.27GB）：python -c "from sentence_transformers import CrossEncoder as C; C('BAAI/bge-reranker-v2-m3')"
RERANK_BACKEND=off
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# CPU 实测约 60ms/对：20 个候选 ≈ 1.25s，10 个 ≈ 0.65s
RERANK_CANDIDATES=20
RERANK_BATCH_SIZE=8
RERANK_MAX_CHARS=600

# ===================== 业务约束 =====================
MAX_UPLOAD_MB=50
MAX_GENERATE_COUNT=20
MAX_TUTOR_TURNS_PER_HOUR=60
MAX_QUESTION_REPAIR_ROUNDS=2
UPLOAD_DIR=./data/uploads

# ===================== Prompt =====================
PROMPT_VERSION=v1
